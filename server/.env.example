# Configure the service manager with these variables; Django does not auto-load this file.
CLOUD_ENV=production
PUBLIC_ORIGIN=https://accounts.example.ru
ALLOWED_HOSTS=accounts.example.ru
DJANGO_SECRET_KEY=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cloud_accounts
PGUSER=cloud_accounts
PGPASSWORD=
PGSSLMODE=require
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=1
SALES_ENABLED=0
RENEWALS_ENABLED=0
CONSENT_VERSION=
SIGNING_KEY_PATH=/etc/cloud-accounts/license-signing.pem
SIGNING_KEY_ID=
LAUNCH_APPROVALS_PATH=/etc/cloud-accounts/release-approvals.json
MAX_DEVICES=3

# Optional community experiment. Keep disabled until launch review is complete.
COMMUNITY_EXPERIMENT_ENABLED=0
COMMUNITY_CHANNEL_ID=0
COMMUNITY_CHANNEL_URL=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
COMMUNITY_SIGNING_KEY_PATH=/etc/cloud-accounts/community-signing.pem
COMMUNITY_SIGNING_KEY_ID=
COMMUNITY_APPROVALS_PATH=/etc/cloud-accounts/community-launch-review.json
