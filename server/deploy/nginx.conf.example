# Included inside http {}. Replace the domain, install a real TLS certificate first.
log_format cloud_private '$remote_addr $request_method $uri $status $request_time';
limit_req_zone $binary_remote_addr zone=cloud_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=cloud_login:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=cloud_bot:10m rate=10r/s;
server {
    listen 443 ssl;
    server_name accounts.example.ru;
    ssl_certificate /etc/letsencrypt/live/accounts.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/accounts.example.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/cloud-accounts.log cloud_private;
    client_max_body_size 64k;
    # Bot and desktop use separate rate buckets. Otherwise channel events could
    # starve account/device checks during a burst. The app verifies the webhook secret.
    location = /hooks/telegram {
        limit_req zone=cloud_bot burst=30 nodelay;
        proxy_set_header Host accounts.example.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
    # Source ranges from YooKassa docs, checked 2026-10-18; recheck before deployment.
    location = /hooks/yookassa {
        allow 185.71.76.0/27;
        allow 185.71.77.0/27;
        allow 77.75.153.0/25;
        allow 77.75.156.11;
        allow 77.75.156.35;
        allow 77.75.154.128/25;
        allow 2a02:5180::/32;
        deny all;
        limit_req zone=cloud_api burst=30 nodelay;
        proxy_set_header Host accounts.example.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        limit_req zone=cloud_api burst=30 nodelay;
        proxy_set_header Host accounts.example.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
    location ~ ^/(auth|o)/ {
        limit_req zone=cloud_login burst=10 nodelay;
        proxy_set_header Host accounts.example.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
}
server {
    listen 80;
    server_name accounts.example.ru;
    return 301 https://accounts.example.ru$request_uri;
}
