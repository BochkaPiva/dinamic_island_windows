[Unit]
Description=Cloud Hub account API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=cloud-accounts
Group=cloud-accounts
WorkingDirectory=/opt/cloud-accounts/server
EnvironmentFile=/etc/cloud-accounts/environment
ExecStart=/opt/cloud-accounts/venv/bin/gunicorn cloud_accounts.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 45 --access-logfile - --access-logformat '%%(h)s %%(m)s %%(U)s %%(s)s %%(L)s'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
