[Unit]
Description=Cloud Hub billing reconciliation tick
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=cloud-accounts
Group=cloud-accounts
WorkingDirectory=/opt/cloud-accounts/server
EnvironmentFile=/etc/cloud-accounts/environment
ExecStart=/opt/cloud-accounts/venv/bin/python manage.py billing_tick
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
